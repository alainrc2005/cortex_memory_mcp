# CORTEX Memory MCP — Configuration Template
# Copy this file to .env and fill in your values

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# Leave empty if Qdrant has no authentication (default for local installs)
# Set your API key if you enabled auth in qdrant config
QDRANT_API_KEY=

# ── fastembed ONNX Model Cache ────────────────────────────────────────────────
# Models are downloaded once (~130 MB total) and cached here
# - all-MiniLM-L6-v2   (~22 MB)  dense embeddings, 384 dimensions
# - SPLADE_PP_en_v1     (~110 MB) sparse BM25-like embeddings
FASTEMBED_CACHE_DIR=./.fastembed_cache

# ── Ollama (optional LLM for scoring, tagging, reranking) ────────────────────
# Ollama must be running with qwen3 pulled:  ollama pull qwen3
# CORTEX degrades gracefully if Ollama is unavailable (no scoring/reranking)
OLLAMA_URL=http://localhost:11434
