# CORTEX Memory MCP — Configuration Template
# Copy this file to .env and fill in your values

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# Leave empty if Qdrant has no authentication (default for local installs)
QDRANT_API_KEY=

# ── fastembed ONNX Model Cache ────────────────────────────────────────────────
# Models are downloaded once (~130 MB total) and cached here
# - all-MiniLM-L6-v2   (~22 MB)  dense embeddings, 384 dimensions
# - SPLADE_PP_en_v1     (~110 MB) sparse BM25-like embeddings
FASTEMBED_CACHE_DIR=./.fastembed_cache

# ── Backend LLM ───────────────────────────────────────────────────────────────
# Controla qué backend se usa para scoring, tagging, reranking y detección de
# contradicciones. Opciones:
#   "openrouter" — Usa modelos en la nube via OpenRouter (recomendado, puede ser gratis)
#   "ollama"     — Usa Ollama local (necesita GPU para ser útil, muy lento en CPU)
#   "none"       — Desactiva LLM completamente (solo fastembed ONNX)
CORTEX_LLM_BACKEND=openrouter

# ── OpenRouter (recomendado) ──────────────────────────────────────────────────
# Regístrate gratis en https://openrouter.ai para obtener tu API key.
# Los modelos con sufijo :free tienen $0.00 por token.
#
# Modelos gratuitos recomendados:
#   google/gemma-4-27b-it:free   — Rápido, buena calidad general (RECOMENDADO)
#   openrouter/free              — Router automático, elige el mejor disponible
#   deepseek/deepseek-v4-flash:free — Alternativa DeepSeek
#
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-27b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Reranker LLM ──────────────────────────────────────────────────────────────
# Activa un segundo paso de reranking LLM después de la búsqueda inicial fastembed.
# Con OpenRouter (nube) es rápido (~1-3s). Con Ollama en CPU era ~90-130s.
# true  = activa reranking semántico (mejor precisión en recall)
# false = usa solo fastembed ONNX (<1s, suficiente para colecciones <200 engramas)
CORTEX_RERANKER_ENABLED=true

# ── Ollama (opcional, solo si CORTEX_LLM_BACKEND=ollama) ─────────────────────
# Ollama debe estar corriendo con qwen3 descargado: ollama pull qwen3
# CORTEX degrada graciosamente si Ollama no está disponible
# OLLAMA_URL=http://localhost:11434
