{
  "name": "langgraph-memory-mcp",
  "version": "3.2.0",
  "description": "MCP Server using LangGraph to manage semantic memory in Qdrant",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build":        "tsc",
    "start":        "node dist/server.js",
    "test":         "vitest run",
    "test:unit":    "vitest run tests/unit",
    "test:int":     "vitest run tests/integration",
    "test:mcp":     "vitest run tests/mcp",
    "test:watch":   "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy":  "node test_cortex.mjs",
    "eval":         "node eval/harness.mjs",
    "longmemeval":  "node eval/longmemeval_cortex.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "^1.9.0",
    "dotenv": "^16.4.5",
    "fastembed": "^2.1.0",
    "kuzu": "^0.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
